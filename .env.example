# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com

# Public Supabase URL (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase Anonymous Key (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (KEEP SECRET - server-side only)
# This key has admin privileges and should NEVER be exposed to clients
SUPABASE_SERVICE_ROLE_KEY=
